  #
  # @return [Either::Left<Object>]
  #
  # pkg:gem/unparser#lib/unparser/either.rb:59
  def fmap(&_arg0); end

  # Unwrap value from left
  #
  # @return [Object]
  #
  # pkg:gem/unparser#lib/unparser/either.rb:73
  def from_left; end

  # Unwrap value from right
  #
  # @return [Object]
  #
  # pkg:gem/unparser#lib/unparser/either.rb:81
  def from_right; end

  # Map over left value
  #
  # @return [Either::Right<Object>]
  #
  # pkg:gem/unparser#lib/unparser/either.rb:92
  def lmap; end
end

# Left
#
