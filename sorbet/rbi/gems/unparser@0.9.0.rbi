  #
  # @api private
  #
  # pkg:gem/unparser#lib/unparser/comments.rb:55
  def take_eol_comments; end

  private

  # pkg:gem/unparser#lib/unparser/comments.rb:119
  def take_up_to_line(line); end

  # pkg:gem/unparser#lib/unparser/comments.rb:114
  def take_while; end

  # pkg:gem/unparser#lib/unparser/comments.rb:123
  def unshift_documents(comments); end

  class << self
    # Return source location part
    #
    # FIXME: This method should not be needed. It does to much inline signalling.
    #
    # @param [Parser::AST::Node] node
    # @param [Symbol] part
    #
    # @return [Parser::Source::Range]
