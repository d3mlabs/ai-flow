  #   anima.to_h # => { :foo => : bar }
  #
  # @return [Hash]
  #
  # @api public
  #
  # pkg:gem/unparser#lib/unparser/anima.rb:102
  def to_h; end

  # Return updated instance
  #
  # @example
  #   klass = Class.new do
  #     include Anima.new(:foo, :bar)
  #   end
  #
  #   foo = klass.new(:foo => 1, :bar => 2)
  #   updated = foo.with(:foo => 3)
  #   updated.foo # => 3
  #   updated.bar # => 2
  #
  # @param [Hash] attributes
  #
  # @return [Anima]
  #
  # @api public
  #
  # pkg:gem/unparser#lib/unparser/anima.rb:123
  def with(attributes); end
end

